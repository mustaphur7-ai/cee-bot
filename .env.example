# Copy to .env and edit as needed. Offline mode is safe and works without credentials.
TRADINGAGENTS_OFFLINE=true
TRADINGAGENTS_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRADINGAGENTS_DB=paper_trades.sqlite3
TRADINGAGENTS_INITIAL_EQUITY=10000
TRADINGAGENTS_RISK_PER_TRADE=0.01
TRADINGAGENTS_DATA_SOURCE=auto
# Web dashboard: served by the same FastAPI app; bind locally by default.
TRADINGAGENTS_WEB_HOST=127.0.0.1
TRADINGAGENTS_WEB_PORT=8000
